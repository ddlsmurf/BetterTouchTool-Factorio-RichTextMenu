              "BTTAdditionalActionData": {
                "BTTScriptType": 3,
                "BTTAppleScriptUsePath": false,
                "BTTScriptLocation": 0,
                "BTTAppleScriptRunInBackground": true,
                "BTTAppleScriptString": "async function frtPaste() {\n  const call = (fn, args) =>\n    typeof globalThis[fn] === \"function\" ? globalThis[fn](args) : callBTT(fn, args);\n  const text = String((await call(\"get_string_variable\", { variable_name: \"frt_paste\" })) || \"\");\n  const left = parseInt(String((await call(\"get_string_variable\", { variable_name: \"frt_left\" })) || \"0\"), 10) || 0;\n  if (!text) return \"nothing to paste\";\n  const args = { text: text, insert_by_pasting: true };\n  if (left > 0) args.move_cursor_left_by_x_after_pasting = left;\n  await call(\"paste_text\", args);\n  return \"ok\";\n}\n",
                "BTTScriptFunctionToCall": "frtPaste"
              },
              "BTTEnabled": 1,
              "BTTOrder": 3
            }
          ]
        },
